# Copy this file to .env for local development.
# Never commit .env because it can contain database credentials.

DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/pasta_perfect

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Use production on the deployed API host.
NODE_ENV=development

# The hosting provider normally supplies PORT.
# Do not commit a production PORT value here.