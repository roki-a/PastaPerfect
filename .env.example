# Copy this file to .env and fill in the values for local development.
# .env is git-ignored and must not be committed.

# Local PostgreSQL database
DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/pasta_perfect

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Use development locally and production when deployed.
NODE_ENV=development

# Do NOT set PORT locally or on the deployed host.
# The hosting provider supplies PORT automatically.